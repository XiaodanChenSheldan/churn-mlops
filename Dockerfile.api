# Dockerfile.api
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (for caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/ ./src/
COPY api.py .

# Create necessary directories with correct permissions
RUN mkdir -p /app/artifacts /app/mlruns /app/data && \
    chmod 777 /app/artifacts /app/mlruns /app/data

# Create non-root user
RUN useradd -m -u 1000 mluser && chown -R mluser:mluser /app
USER mluser

# Ensure artifacts directory is writable (run as root for this step only)
USER root
RUN chown -R mluser:mluser /app/artifacts /app/mlruns /app/data
USER mluser

EXPOSE 8000

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]